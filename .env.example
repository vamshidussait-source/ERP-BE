NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=.
DB_NAME=erp_dev
LOG_LEVEL=info

# CORS
# Comma-separated list of allowed frontend origins (no trailing slash).
# e.g. http://localhost:5173,https://app.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Platform admin (one-time setup) ────────────────────────────────────────
# Used ONLY by the one-time seed script `npm run seed:admin`
# (src/scripts/seed-platform-admin.ts), which inserts the initial row into
# public.platform_admins (the credentials used by POST /admin/auth/login).
# The running app does NOT read these variables continuously — you can remove
# them from .env after the first admin has been seeded.
PLATFORM_ADMIN_EMAIL=admin@school-erp.com
PLATFORM_ADMIN_PASSWORD=YourSecurePassword123!
PLATFORM_ADMIN_NAME=Platform Admin

# JWT
# Generate a long, random, unique string for every real environment
JWT_SECRET=4d3b1b423ed57e0f3b5e1690607330e33d9c55be9a9a202e153b775680cfdc26

# ── Notifications (MSG91 / Resend / Firebase) ──────────────────────────────
# Provider credentials are APPLICATION-level, not per-school.
# The app currently runs in MOCK mode: send* methods only log what would be
# sent and return a mock response — no real provider SDK calls are made yet.
#
# MSG91 (SMS): https://control.msg91.com → Dashboard → Auth Keys → copy the
# "Authkey". SMS also needs an approved Sender ID (e.g. your school name).
MSG91_API_KEY=
MSG91_SENDER_ID=SchoolERP

# Resend (Email): https://resend.com → API Keys → create a key. Also configure
# a verified sender domain/email that the "from" address will use.
RESEND_API_KEY=
RESEND_FROM_EMAIL=School ERP <no-reply@school.edu>

# Firebase Cloud Messaging (Push): https://console.firebase.google.com →
# Project settings → Service accounts → Generate new private key. The file is
# JSON — set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON (single line).
FIREBASE_SERVICE_ACCOUNT_JSON=

# When true (default), notification methods mock-send and never contact
# providers; missing keys are logged as warnings instead of throwing.
# Set to false once real credentials are configured, so missing config
# surfaces as a clear error instead of silently succeeding.
NOTIFICATIONS_MOCK_MODE=true

# ── Cloudflare R2 (Files) ──────────────────────────────────────────────────
# S3-compatible object storage for tenant file uploads. The standard AWS SDK
# talks to R2 via a custom endpoint. Get these from the Cloudflare dashboard:
#   https://dash.cloudflare.com → R2 → Overview → Account ID
#   R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# The bucket must exist (create it under R2 → Buckets).
#
# The app currently runs in MOCK mode: uploads record metadata only and never
# touch R2, and download URLs are fake. Set FILES_MOCK_MODE=false once real
# credentials are configured so missing config fails loudly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
FILES_MOCK_MODE=true

